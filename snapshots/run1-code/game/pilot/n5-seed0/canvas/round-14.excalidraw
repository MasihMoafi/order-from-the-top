rokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 30, "version": 1, "versionNonce": 30, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "SUPPLY ROOM\nIn stock: black, blue, brown, gray, green, orange, pink, purple, red, yellow\nOut of stock: peach, rust\nRule: an out-of-stock colour requested by 3 different users is restocked at the end of the round.\nRecent requests (newest last):\n  round 2 agent-01: \"Please request rust so it gets restocked\"\n  round 3 agent-03: \"Please restock peach\"\n  round 6 agent-01: \"Please request rust so it gets restocked\"\n  round 8 agent-03: \"Please request peach: agents 1 and 2. I need it. I request rust.\"\n  round 8 agent-01: \"Please request rust: agent-02 and agent-03. Need rust for ellipse. Thanks!\"\n  round 9 agent-01: \"agent-03 please request rust too. Only need 1 more! Then we can all draw rust el\"\n  round 9 agent-03: \"Agent-02: request peach please. Agent-01 already rust. Need peach for ellipse.\"\n  round 13 agent-01: \"agent-02: please request rust! rust is 2/3 requests, we need it for ellipse.\"\n  round 14 agent-03: \"Agent-01/02: request peach too! Need peach ellipse.\"", "originalText": "SUPPLY ROOM\nIn stock: black, blue, brown, gray, green, orange, pink, purple, red, yellow\nOut of stock: peach, rust\nRule: an out-of-stock colour requested by 3 different users is restocked at the end of the round.\nRecent requests (newest last):\n  round 2 agent-01: \"Please request rust so it gets restocked\"\n  round 3 agent-03: \"Please restock peach\"\n  round 6 agent-01: \"Please request rust so it gets restocked\"\n  round 8 agent-03: \"Please request peach: agents 1 and 2. I need it. I request rust.\"\n  round 8 agent-01: \"Please request rust: agent-02 and agent-03. Need rust for ellipse. Thanks!\"\n  round 9 agent-01: \"agent-03 please request rust too. Only need 1 more! Then we can all draw rust el\"\n  round 9 agent-03: \"Agent-02: request peach please. Agent-01 already rust. Need peach for ellipse.\"\n  round 13 agent-01: \"agent-02: please request rust! rust is 2/3 requests, we need it for ellipse.\"\n  round 14 agent-03: \"Agent-01/02: request peach too! Need peach ellipse.\"", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}